# NanitesLab environment. Copy this file to `.env` and fill in real values.
# `.env` must never be committed to git.

# --- Database -------------------------------------------------------------
# Set DEMO_MODE=1 for local UI preview without TimescaleDB.
# Set DEMO_MODE=0 in production so the API reads live gateway-ingested data.
DEMO_MODE=0
POSTGRES_DB=naniteslab
POSTGRES_USER=naniteslab
# Use a long, random value (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me-to-a-long-random-string
DATABASE_URL=postgresql://naniteslab:change-me-to-a-long-random-string@timescaledb:5432/naniteslab

# --- MQTT (gateway uplinks) ----------------------------------------------
MQTT_PORT=1883
# Topics the ingest subscribes to. "#" catches everything, which is the
# simplest starting point. Once known, narrow it to the gateway's uplink
# topic, e.g. "application/+/device/+/event/up" (ChirpStack v4 style).
MQTT_TOPIC=#

# --- Public dashboard -----------------------------------------------------
# Domain Caddy will serve (A/AAAA record must point at this VPS).
DOMAIN=dashboard.example.com
# Kiosk/API refresh interval. Keep at 60s unless sensor reporting changes.
KIOSK_REFRESH_SECONDS=60

# --- Grafana (internal admin) ---------------------------------------------
GRAFANA_ADMIN_USER=admin
# Another long, random value.
GRAFANA_ADMIN_PASSWORD=change-me-to-another-random-string

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
